       <property name="styleSheet">
        <string notr="true">QPushButton#viewPdfButton  {
    background-color: #8da3bf; /* Vert sapin */
	color: rgb(141, 163, 191);
    color: white;
    font-size: 18px;
    font-weight: bold;
    border-radius: 18px; /* La moitié de la taille pour un cercle */
    border: none;
    transition: all 0.3s ease-in-out;
    text-align: center;
}

QPushButton#viewPdfButton:hover {
    box-shadow: 0px 3px 8px rgba(1, 121, 111, 0.4);
	background-color: rgb(115, 131, 168);
}

QPushButton#viewPdfButton :pressed {
    box-shadow: 0px 2px 5px rgba(1, 121, 111, 0.5);
	background-color: #7992bf;
}</string>
