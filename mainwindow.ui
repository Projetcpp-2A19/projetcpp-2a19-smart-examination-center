    border-radius: 20px;
    border: 2px dashed #3A7BD5;
    text-align: center; /* Alignement horizontal */
    qproperty-alignment: 'AlignCenter'; /* Alignement Qt */
}

QPushButton#pdfExambtn:hover {
    background-color: #A0C4FF; 
    border: 2px dashed #A0C4FF; 
    color: #F9F9F9; 
}

QPushButton#pdfExambtn:pressed {
