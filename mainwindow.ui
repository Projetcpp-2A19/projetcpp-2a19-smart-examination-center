     <widget class="QTableView" name="tableFourn">
      <property name="geometry">
       <rect>
        <x>20</x>
        <y>80</y>
        <width>721</width>
        <height>351</height>
       </rect>
      </property>
      <property name="styleSheet">
       <string notr="true">#tableFourn {
    border: 2px solid #A0B9D9; /* Légère bordure bleu-gris pastel */
    border-radius: 10px;       /* Coins arrondis */
    background-color: #F0F4F8; /* Fond légèrement gris-bleu */
    gridline-color: #A0B9D9;   /* Couleur des lignes du tableau */
    selection-background-color: #4A90E2; /* Couleur de sélection */
    selection-color: white;     /* Texte blanc lors de la sélection */
}

#tableFourn::item {
    padding: 8px;              /* Espacement entre le texte et la cellule */
    color: #2C3E50;            /* Texte bleu foncé */
}

#tableFourn::item:selected {
    background-color: #4A90E2; /* Fond bleu lors de la sélection */
    color: white;              /* Texte blanc */
}

#tableFourn QHeaderView::section {
    background-color: #A0B9D9; /* En-tête avec une teinte bleu-gris */
    color: #2C3E50;            /* Texte des en-têtes en bleu foncé */
    padding: 5px;              /* Espacement interne dans l'en-tête */
    border: 2px solid #A0B9D9; /* Légère bordure bleu-gris pastel */
    font-weight: bold;         /* Mettre le texte en gras */
}

#tableFourn QTableCornerButton::section {
    background-color: #4A90E2; /* Coin supérieur gauche */
    border: 2px solid #A0B9D9; /* Légère bordure bleu-gris pastel */
}

#tableFourn QHeaderView {
    border: none;              /* Supprimer la bordure de l'en-tête */
}</string>
      </property>
      <attribute name="horizontalHeaderDefaultSectionSize">
       <number>40</number>
      </attribute>
     </widget>
