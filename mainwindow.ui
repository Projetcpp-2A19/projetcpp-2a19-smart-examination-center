      <property name="styleSheet">
       <string notr="true">QPushButton#ModButton  {
    color: white;
	background-color: rgb(58, 123, 213);
    font-size: 16px;
    font-weight: bold;
    border-radius: 18px; /* La moitié de la taille pour un cercle */
    border: none;
    transition: all 0.3s ease-in-out;
    text-align: center;
}

QPushButton#ModButton:hover {
    background-color: rgb(3, 150, 138); /* Vert sapin plus clair au survol */
    box-shadow: 0px 3px 8px rgba(1, 121, 111, 0.4);
}

QPushButton#ModButton :pressed {
    background-color: rgb(0, 100, 92); /* Vert sapin plus foncé*/
    box-shadow: 0px 2px 5px rgba(1, 121, 111, 0.5);
}</string>
