   <widget class="QPushButton" name="closeBtn">
    <property name="geometry">
     <rect>
      <x>1410</x>
      <y>10</y>
      <width>36</width>
      <height>36</height>
     </rect>
    </property>
    <property name="cursor">
     <cursorShape>ClosedHandCursor</cursorShape>
    </property>
    <property name="styleSheet">
     <string notr="true">QPushButton#closeBtn {
	image: url(:/new/prefix1/img/close.png);
    background-color: #D64545; /* Rouge brique pastel */
    color: white;
    font-size: 16px;
    font-weight: bold;
    min-width: 36px; /* Largeur minimale */
    min-height: 36px; /* Hauteur minimale */
    max-width: 36px; /* Largeur maximale */
    max-height: 36px; /* Hauteur maximale */
    border-radius: 18px; /* La moitié de la taille pour un cercle */
    border: none;
    transition: all 0.3s ease-in-out;
    text-align: center;
}

QPushButton#closeBtn:hover {
    background-color: #E06666; /* Rouge plus clair au survol */
    box-shadow: 0px 3px 8px rgba(214, 69, 69, 0.4);
}

QPushButton#closeBtn:pressed {
    background-color: #B83232; /* Rouge plus foncé au clic */
    box-shadow: 0px 2px 5px rgba(184, 50, 50, 0.5);
}
</string>
    </property>
    <property name="text">
     <string/>
    </property>
    <property name="icon">
     <iconset theme="QIcon::ThemeIcon::ApplicationExit"/>
    </property>
   </widget>
