        <property name="styleSheet">
         <string notr="true">#TriButton { 
    background-color: #FFFFFF; /* Fond blanc pour un bon contraste */
    border: 2px solid rgb(1, 121, 111); /* Bordure verte foncée */
    border-radius: 20px; /* Coins arrondis */
    padding: 10px 15px; /* Espacement interne ajusté */
    font-size: 16px; /* Taille de police */
    font-weight: bold; /* Texte en gras pour une meilleure lisibilité */
    color: #2C3E50; /* Bleu foncé pour le texte */
    cursor: pointer; /* Curseur en main pour montrer l'interactivité */
    transition: all 0.3s ease-in-out; /* Animation fluide des effets */
}

#TriButton:hover { 
    background-color: rgb(1, 121, 111); /* Fond vert au survol */
    color: #FFFFFF; /* Texte blanc pour un bon contraste */
}

#TriButton:focus, #TriButton:active { 
    border: 2px solid rgb(1, 121, 111); /* Bordure renforcée */
    background-color: #E8F6F3; /* Léger vert pastel au focus */
    outline: none; /* Supprime le contour bleu par défaut */
}
</string>
        </property>
