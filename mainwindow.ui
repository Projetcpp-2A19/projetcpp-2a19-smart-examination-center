     <string notr="true">QPushButton#homeBtn {
	    color: rgb(8, 8, 8);
    background-color: rgb(1, 121, 111); /* Vert sapin */
    color: white;
    font-size: 16px;
    font-weight: bold;
    min-width: 36px; /* Largeur minimale */
    min-height: 36px; /* Hauteur minimale */
    max-width: 36px; /* Largeur maximale */
    max-height: 36px; /* Hauteur maximale */
    border-radius: 18px; /* La moitié de la taille pour un cercle */
    border: none;
    transition: all 0.3s ease-in-out;
    text-align: center;
}

QPushButton#homeBtn:hover {
    background-color: rgb(3, 150, 138); /* Vert sapin plus clair au survol */
    box-shadow: 0px 3px 8px rgba(1, 121, 111, 0.4);
}

QPushButton#homeBtn:pressed {
    background-color: rgb(0, 100, 92); /* Vert sapin plus foncé au clic */
    box-shadow: 0px 2px 5px rgba(1, 121, 111, 0.5);
}
