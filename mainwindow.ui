     <property name="styleSheet">
      <string notr="true">QPushButton#supButton {
    background-color: #4A90E2;
    border: 2px solid #4A90E2;
    border-radius: 20px; /* Coins arrondis */
    padding: 8px 12px; /* Espacement interne */
    font-size: 16px; /* Taille de police */
    font-weight: bold; /* Texte en gras */
    color: black; /* Couleur du texte */
    selection-background-color: #A0B9D9; /* Couleur de sélection */
    qproperty-icon: url(:/new/prefix1/img/rechercher-des-personnes.png);
    qproperty-iconSize: 32px 32px; /* Taille de l'icône */
    transition: background-color 0.3s ease, border-color 0.3s ease; /* Animation fluide */
}

/* Effet au survol */
QPushButton#supButton:hover { /* &lt;-- PAS d'espace */
    background-color: #F9F9F9; /* Bleu très clair */
    border-color: #6C91C2; /* Bleu un peu plus foncé */
}

/* Effet lors du clic */
QPushButton#supButton:pressed { /* &lt;-- PAS d'espace */
    background-color: #C74C4C; /* Rouge foncé */
    border-color: #C74C4C; /* Rouge foncé */
    color: #FFFFFF; /* Texte blanc pour contraste */
}
</string>
