       <property name="styleSheet">
        <string notr="true">#tableView {
    border: 2px solid #4A90E2; /* Bordure bleue */
    border-radius: 10px; /* Coins arrondis */
    background-color: #F0F4F8; /* Fond légèrement gris-bleu */
    gridline-color: #A0B9D9; /* Couleur des lignes du tableau */
    selection-background-color: #4A90E2; /* Couleur de sélection */
    selection-color: white; /* Texte blanc lors de la sélection */
}

#tableView::item {
    padding: 8px; /* Espacement entre le texte et la cellule */
    color: #2C3E50; /* Texte bleu foncé */
}

#tableView::item:selected {
    background-color: #4A90E2; /* Fond bleu lors de la sélection */
    color: white; /* Texte blanc */
}

#tableView QHeaderView::section {
    background-color: #A0B9D9; /* En-tête avec une teinte bleu-gris */
    color: #2C3E50; /* Texte des en-têtes en bleu foncé */
    padding: 6px;
    border: 1px solid #4A90E2; /* Bordure des en-têtes */
    font-weight: bold;
}

#tableView QTableCornerButton::section {
    background-color: #4A90E2; /* Coin supérieur gauche */
    border: 1px solid #4A90E2;
}
