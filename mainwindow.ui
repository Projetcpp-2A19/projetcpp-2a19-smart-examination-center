        <property name="styleSheet">
         <string notr="true">QPushButton#btnEnvoyerSMS {
    background-color: #28A745; /* Vert standard pour l'envoi */
    color: white;
    font-size: 16px;
    font-weight: bold;
    padding: 10px 20px; /* Uniformiser le padding */
    border-radius: 20px;
    border: 2px dashed #218838; /* Bordure légèrement plus foncée */
    text-align: center; /* Alignement horizontal */
    qproperty-alignment: 'AlignCenter'; /* Alignement Qt */
}

QPushButton#btnEnvoyerSMS:hover {
    background-color: #218838; /* Vert plus foncé au survol */
    border: 2px dashed #1E7E34; /* Bordure encore plus foncée */
    color: #F9F9F9; 
}

QPushButton#btnEnvoyerSMS:pressed {
    background-color: #1E7E34; /* Vert encore plus foncé quand pressé */
    border: 2px dashed #155724; /* Bordure assombrie */
}
</string>
