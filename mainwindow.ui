        <string notr="true">QLineEdit {
    background-color: #FFFFFF; /* Blanc pur pour un bon contraste */
    border: 2px solid  rgb(1, 121, 111); /* Bordure bleu-gris pastel */
    border-radius: 20px; /* Coins arrondis */
